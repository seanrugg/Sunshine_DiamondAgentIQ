# Copy to .env. Everything is optional: with nothing set, the server answers
# from the rules data alone (offline mode), exactly like the phone does.

PORT=8787
HOST=0.0.0.0

# Any OpenAI-compatible chat endpoint. Examples:
#   Ollama on the same VPS:   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2:3b
#   Ollama in docker-compose: LLM_BASE_URL=http://ollama:11434/v1
#   NVIDIA / OpenRouter / other hosted API: set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY
LLM_BASE_URL=
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
LLM_TIMEOUT_MS=30000

# Lock the API to your app's origin in production (default *).
CORS_ORIGIN=*
